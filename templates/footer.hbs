<footer class="footer">
  <div class="footer-inner gb-footer-inner">
    <div class="gb-footer-brand">
      {{#link 'help_center' class='gb-footer-title'}}
        {{#is help_center.locale 'en-nl'}}
          {{#if settings.footer_title_en}}
            {{settings.footer_title_en}}
          {{else}}
            {{help_center.name}}
          {{/if}}
        {{else}}
          {{#if settings.footer_title}}
            {{settings.footer_title}}
          {{else}}
            {{help_center.name}}
          {{/if}}
        {{/is}}
      {{/link}}
      {{#is help_center.locale 'en-nl'}}
        {{#if settings.footer_text_en}}
          <p>{{settings.footer_text_en}}</p>
        {{/if}}
      {{else}}
        {{#if settings.footer_text}}
          <p>{{settings.footer_text}}</p>
        {{/if}}
      {{/is}}
    </div>

    <div class="gb-footer-actions">
      {{#is help_center.locale 'en-nl'}}
        <nav class="gb-footer-links" aria-label="Footer">
          {{#if settings.footer_link_1_label_en}}
            <a href="{{settings.footer_link_1_url_en}}">{{settings.footer_link_1_label_en}}</a>
          {{/if}}
          {{#if settings.footer_link_2_label_en}}
            <a href="{{settings.footer_link_2_url_en}}">{{settings.footer_link_2_label_en}}</a>
          {{/if}}
        </nav>
      {{else}}
        <nav class="gb-footer-links" aria-label="Voettekst">
          {{#if settings.footer_link_1_label}}
            <a href="{{settings.footer_link_1_url}}">{{settings.footer_link_1_label}}</a>
          {{/if}}
          {{#if settings.footer_link_2_label}}
            <a href="{{settings.footer_link_2_url}}">{{settings.footer_link_2_label}}</a>
          {{/if}}
        </nav>
      {{/is}}

      <div class="gb-footer-column gb-footer-legal">
        <h2 class="gb-footer-heading">Legal</h2>
        {{#is help_center.locale 'en-nl'}}
          <nav class="gb-footer-links" aria-label="Legal">
            <a href="https://www.zekerarbo.nl/disclaimer/">Disclaimer</a>
            <a href="https://www.zekerarbo.nl/privacystatement/">Privacy statement</a>
            <a href="https://www.zekerarbo.nl/certificaten/">Certificates</a>
            <a href="https://www.zekerarbo.nl/cookiestatement/">Cookie statement</a>
            <a href="https://www.zekerarbo.nl/#">Cookie settings</a>
            <a href="https://www.zekerarbo.nl/algemene_voorwaarden/">Terms and conditions</a>
            <a href="https://www.zekerarbo.nl/klachtenregeling/">Complaints procedure</a>
          </nav>
        {{else}}
          <nav class="gb-footer-links" aria-label="Legal">
            <a href="https://www.zekerarbo.nl/disclaimer/">Disclaimer</a>
            <a href="https://www.zekerarbo.nl/privacystatement/">Privacystatement</a>
            <a href="https://www.zekerarbo.nl/certificaten/">Certificaten</a>
            <a href="https://www.zekerarbo.nl/cookiestatement/">Cookiestatement</a>
            <a href="https://www.zekerarbo.nl/#">Cookie instellingen</a>
            <a href="https://www.zekerarbo.nl/algemene_voorwaarden/">Algemene voorwaarden</a>
            <a href="https://www.zekerarbo.nl/klachtenregeling/">Klachtenregeling</a>
          </nav>
        {{/is}}
      </div>
    </div>
  </div>
</footer>
