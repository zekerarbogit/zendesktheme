<h1 class="visibility-hidden">{{ help_center.name }}</h1>

<section id="main-content" class="section hero gb-hero">
  <div class="hero-inner">
    <h2 class="gb-hero-title">
      {{#is help_center.locale 'en-nl'}}
        {{#if settings.home_hero_title_en}}
          {{settings.home_hero_title_en}}
        {{else}}
          {{help_center.name}}
        {{/if}}
      {{else}}
        {{#if settings.home_hero_title}}
          {{settings.home_hero_title}}
        {{else}}
          {{help_center.name}}
        {{/if}}
      {{/is}}
    </h2>
    {{#is help_center.locale 'en-nl'}}
      {{#if settings.home_hero_subtitle_en}}
        <p class="gb-hero-subtitle">{{settings.home_hero_subtitle_en}}</p>
      {{/if}}
    {{else}}
      {{#if settings.home_hero_subtitle}}
        <p class="gb-hero-subtitle">{{settings.home_hero_subtitle}}</p>
      {{/if}}
    {{/is}}
  </div>
</section>

<div class="container">
  <section class="section knowledge-base gb-home">
    <header class="gb-section-header">
      <h2>{{ t 'categories' }}</h2>
    </header>
    <section class="categories blocks">
      <ul class="blocks-list gb-category-grid">
        {{#each categories}}
          {{#if ../has_multiple_categories}}
            <li class="blocks-item gb-category-card">
              <a href='{{url}}' class="blocks-item-link gb-category-card-link">
                <span class="gb-category-copy">
                  <span class="blocks-item-title">{{name}}</span>
                  <span class="blocks-item-description">{{excerpt description}}</span>
                </span>
                <span class="gb-category-card-arrow" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" focusable="false" viewBox="0 0 18 18">
                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.5 9h10m-4-4 4 4-4 4"/>
                  </svg>
                </span>
              </a>
              {{#if sections}}
                <ul class="gb-card-section-list">
                  {{#each sections}}
                    <li><a href="{{url}}">{{name}}</a></li>
                  {{/each}}
                </ul>
              {{/if}}
            </li>
          {{else}}
            {{#each sections}}
              <li class="blocks-item gb-category-card">
                <a href='{{url}}' class="blocks-item-link gb-category-card-link">
                  <span class="gb-category-copy">
                    <span class="blocks-item-title">
                      {{name}}
                    </span>
                    <span class="blocks-item-description">{{excerpt description}}</span>
                  </span>
                  <span class="gb-category-card-arrow" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" focusable="false" viewBox="0 0 18 18">
                      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.5 9h10m-4-4 4 4-4 4"/>
                    </svg>
                  </span>
                </a>
              </li>
            {{/each}}
          {{/if}}
        {{/each}}
      </ul>
      {{pagination}}
    </section>

    <section class="gb-home-story" aria-labelledby="home-story-title">
      <div class="gb-home-story-media">
        <img
          src="{{#if settings.home_story_image}}{{settings.home_story_image}}{{else}}https://img.diffu.se/zekerarbo.nl/uploads/2024/09/zekerarbo-diensten.jpg{{/if}}"
          alt=""
          loading="lazy"
        />
        <img
          src="{{#if settings.home_story_image_secondary}}{{settings.home_story_image_secondary}}{{else}}https://img.diffu.se/zekerarbo.nl/uploads/2024/12/ArboBas.jpg{{/if}}"
          alt=""
          loading="lazy"
        />
      </div>
      <div class="gb-home-story-copy">
        {{#is help_center.locale 'en-nl'}}
          <p class="gb-home-story-kicker">Healthy and fit at work</p>
          <h2 id="home-story-title">Together, we make work stronger</h2>
          <p>From prevention to absence support, ZekerArbo helps people and organisations keep moving forward with practical expertise and personal attention.</p>
          <a href="https://www.zekerarbo.nl/over-ons/" class="gb-home-story-link">Discover ZekerArbo</a>
        {{else}}
          <p class="gb-home-story-kicker">Gezond en inzetbaar aan het werk</p>
          <h2 id="home-story-title">Samen maken we werk sterker</h2>
          <p>Van preventie tot verzuimbegeleiding: ZekerArbo helpt mensen en organisaties vooruit met praktische expertise en persoonlijke aandacht.</p>
          <a href="https://www.zekerarbo.nl/over-ons/" class="gb-home-story-link">Ontdek ZekerArbo</a>
        {{/is}}
      </div>
    </section>

    {{#is help_center.locale 'en-nl'}}
      {{#if settings.home_content_title_en}}
        <section class="gb-home-extra">
          <div class="gb-home-extra-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" focusable="false" viewBox="0 0 24 24">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5.75A2.75 2.75 0 0 1 7.75 3h8.5A2.75 2.75 0 0 1 19 5.75v6.5A2.75 2.75 0 0 1 16.25 15H12l-4.5 4v-4.19A2.75 2.75 0 0 1 5 12.25v-6.5Z"/>
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" d="M9 9h6m-6 3h3"/>
            </svg>
          </div>
          <div class="gb-home-extra-copy">
            <h2>{{settings.home_content_title_en}}</h2>
            {{#if settings.home_content_body_en}}
              <p>{{settings.home_content_body_en}}</p>
            {{/if}}
          </div>
          {{#if settings.home_content_link_label_en}}
            <a class="gb-home-extra-link" href="{{settings.home_content_link_url_en}}">
              <span>{{settings.home_content_link_label_en}}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8h9m-4-4 4 4-4 4"/>
              </svg>
            </a>
          {{/if}}
        </section>
      {{/if}}
    {{else}}
      {{#if settings.home_content_title}}
        <section class="gb-home-extra">
          <div class="gb-home-extra-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" focusable="false" viewBox="0 0 24 24">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5.75A2.75 2.75 0 0 1 7.75 3h8.5A2.75 2.75 0 0 1 19 5.75v6.5A2.75 2.75 0 0 1 16.25 15H12l-4.5 4v-4.19A2.75 2.75 0 0 1 5 12.25v-6.5Z"/>
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" d="M9 9h6m-6 3h3"/>
            </svg>
          </div>
          <div class="gb-home-extra-copy">
            <h2>{{settings.home_content_title}}</h2>
            {{#if settings.home_content_body}}
              <p>{{settings.home_content_body}}</p>
            {{/if}}
          </div>
          {{#if settings.home_content_link_label}}
            <a class="gb-home-extra-link" href="{{settings.home_content_link_url}}">
              <span>{{settings.home_content_link_label}}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8h9m-4-4 4 4-4 4"/>
              </svg>
            </a>
          {{/if}}
        </section>
      {{/if}}
    {{/is}}

    {{#if promoted_articles}}
      <section class="articles gb-home-content-section gb-home-promoted">
        <h2>
          {{#is help_center.locale 'en-nl'}}Popular articles{{else}}Veel gezocht{{/is}}
        </h2>
        <ul class="article-list promoted-articles gb-home-article-grid">
          {{#each promoted_articles}}
            <li class="promoted-articles-item">
                <a href="{{url}}">
                  {{title}}

                  {{#if internal}}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" focusable="false" viewBox="0 0 16 16" class="icon-lock" title="{{t 'internal'}}">
                      <rect width="12" height="9" x="2" y="7" fill="currentColor" rx="1" ry="1"/>
                      <path fill="none" stroke="currentColor" d="M4.5 7.5V4a3.5 3.5 0 017 0v3.5"/>
                    </svg>
                  {{/if}}
                </a>
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}
  </section>

  {{#if help_center.community_enabled}}
    <section class="section home-section community">
      <h2>{{t 'community'}}</h2>
      {{#link 'community' class='community-link'}}
        {{t 'join_conversation'}}
      {{/link}}

      <div class="community-image"></div>
    </section>
  {{/if}}

  <section class="section home-section activity gb-home-updates">
    {{#if settings.show_recent_activity}}
      <header class="gb-home-section-header">
        <h2>{{#is help_center.locale 'en-nl'}}New and updated{{else}}Nieuw en gewijzigd{{/is}}</h2>
      </header>
      <div class="gb-home-updates-content">
        {{recent_activity}}
      </div>
    {{/if}}
  </section>
</div>
